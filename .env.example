# انسخ هالملف لـ .env.local وعبّي القيم. .env.local ممنوع ينرفع على git.

# Supabase (من لوحة المشروع: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# للسيرفر بس. ممنوع يكون عليه NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Claude API، للسيرفر بس
ANTHROPIC_API_KEY=

# مفتاح سري لاشتقاق كلمة السر من رمز الدخول (32 بايت عشوائي، base64). للسيرفر بس.
# تغييره بيبطّل كل الرموز الحالية.
AUTH_PIN_PEPPER=

# إشعارات Web Push (بتنولد بـ: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# سر بيبعته pg_cron مع طلب التذكيرات، مشان ما حدا غيره يناديها
CRON_SECRET=
